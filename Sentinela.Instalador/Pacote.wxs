<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Sentinela" Manufacturer="Franklin Carvalho" Version="!(bind.FileVersion.SentinelaExe)"
           UpgradeCode="8CFC0F67-74CA-4AE3-A87F-B0A83A08C107" Scope="perMachine"
           InstallerVersion="500" Language="1046" Compressed="yes">
    <!-- UpgradeCode permanente do produto: nunca alterar, para preservar upgrades. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="Já existe uma versão mais nova do Sentinela instalada. A instalação foi cancelada." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="Sentinela.ico" SourceFile="..\Sentinela\sentinela.ico" />
    <Icon Id="IconeAtalho.exe" SourceFile="$(var.Publicacao)Sentinela.exe" />
    <Property Id="ARPPRODUCTICON" Value="Sentinela.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/nilknarfsam/sentinela" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/nilknarfsam/sentinela" />
    <Property Id="ARPCOMMENTS" Value="As configurações em %LOCALAPPDATA%\Sentinela podem permanecer após a desinstalação." />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="PastaInstalacao" Name="Sentinela" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Produto" Title="Sentinela" Level="1">
      <ComponentRef Id="Aplicativo" />
      <ComponentRef Id="AtalhoMenu" />
      <Files Include="$(var.Publicacao)**" Directory="PastaInstalacao">
        <Exclude Files="$(var.Publicacao)Sentinela.exe" />
        <Exclude Files="$(var.Publicacao)**\*.pdb" />
      </Files>
    </Feature>

    <CustomAction Id="FecharSentinela" Directory="System64Folder" ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /F /T /IM Sentinela.exe"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="CriarTarefas" FileRef="SentinelaExe" ExeCommand="--instalar-tarefas --sid [UserSID]"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="DesfazerTarefas" FileRef="SentinelaExe" ExeCommand="--remover-tarefas"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="RemoverTarefas" FileRef="SentinelaExe" ExeCommand="--remover-tarefas"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="AbrirSentinela" Directory="System64Folder" ExeCommand="&quot;[System64Folder]schtasks.exe&quot; /run /tn Sentinela-Abrir"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="FecharSentinela" Before="RemoveExistingProducts" />
      <Custom Action="DesfazerTarefas" Before="CriarTarefas" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
      <!-- Instalação feita por SYSTEM (implantação em massa) não tem usuário: pula as tarefas. -->
      <Custom Action="CriarTarefas" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot; AND UserSID &lt;&gt; &quot;S-1-5-18&quot;" />
      <Custom Action="RemoverTarefas" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- Abre só em instalação ou atualização com tela (inclusive /passive); não em /qn nem em reparo. -->
      <Custom Action="AbrirSentinela" Before="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot; AND NOT Installed AND UILevel &gt; 2 AND UserSID &lt;&gt; &quot;S-1-5-18&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <DirectoryRef Id="PastaInstalacao">
      <Component Id="Aplicativo" Guid="*">
        <File Id="SentinelaExe" Source="$(var.Publicacao)Sentinela.exe" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Sentinela" Name="Instalado" Type="integer" Value="1" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\*\shell\SentinelaVerificar">
          <RegistryValue Type="string" Value="Verificar com o Sentinela" />
          <RegistryValue Name="MUIVerb" Type="string" Value="Verificar com o Sentinela" />
          <RegistryValue Name="Icon" Type="string" Value="&quot;[#SentinelaExe]&quot;,0" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\*\shell\SentinelaVerificar\command">
          <RegistryValue Type="string" Value="&quot;[#SentinelaExe]&quot; --verificar &quot;%1&quot;" />
          <RegistryValue Name="ComandoInstalado" Type="integer" Value="1" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\Directory\shell\SentinelaVerificar">
          <RegistryValue Type="string" Value="Verificar com o Sentinela" />
          <RegistryValue Name="MUIVerb" Type="string" Value="Verificar com o Sentinela" />
          <RegistryValue Name="Icon" Type="string" Value="&quot;[#SentinelaExe]&quot;,0" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\Directory\shell\SentinelaVerificar\command">
          <RegistryValue Type="string" Value="&quot;[#SentinelaExe]&quot; --verificar &quot;%1&quot;" />
          <RegistryValue Name="ComandoInstalado" Type="integer" Value="1" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AtalhoMenu" Guid="*">
        <Shortcut Id="AtalhoSentinela" Name="Sentinela" Target="[System64Folder]schtasks.exe"
                  Arguments="/run /tn Sentinela-Abrir" WorkingDirectory="PastaInstalacao"
                  Icon="IconeAtalho.exe" Show="minimized" Description="Sentinela" />
        <RegistryValue Root="HKLM" Key="Software\Sentinela" Name="AtalhoInstalado" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

  </Fragment>
</Wix>
