<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms só para o ícone da bandeja (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>sentinela.ico</ApplicationIcon>
    <AssemblyName>Sentinela</AssemblyName>
    <RootNamespace>Sentinela</RootNamespace>
    <Product>Sentinela</Product>
    <Copyright>Copyright (C) 2026 Franklin Carvalho</Copyright>
    <Version>1.6.2</Version>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sentinela.Testes" />
    <!-- Evita conflito de nomes WPF x WinForms (Application, MessageBox...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icones\*.ico" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
