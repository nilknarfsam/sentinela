<Window x:Class="PainelPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Painel do PC" Width="1100" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource Fundo}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== MENU LATERAL ===================== -->
        <Border Background="{StaticResource Lateral}" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,16,26">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Destaque}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xEA18;" Foreground="White" FontSize="17" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Painel do PC" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="motor: Windows Defender" Style="{StaticResource Fraco}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="22,0,16,20">
                    <TextBlock x:Name="TxtAdminMenu" Style="{StaticResource Fraco}" FontSize="11"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="MenuInicio" Style="{StaticResource ItemMenu}" Tag="&#xE80F;" Content="Início" IsChecked="True" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuVarredura" Style="{StaticResource ItemMenu}" Tag="&#xE721;" Content="Varredura" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuAmeacas" Style="{StaticResource ItemMenu}" Tag="&#xE7BA;" Content="Ameaças e quarentena" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuLimpeza" Style="{StaticResource ItemMenu}" Tag="&#xE74D;" Content="Otimização" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuInicializacao" Style="{StaticResource ItemMenu}" Tag="&#xE7E8;" Content="Inicialização" Checked="Menu_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== CONTEÚDO ===================== -->
        <DockPanel Grid.Column="1">
            <!-- Aviso de administrador -->
            <Border x:Name="FaixaAdmin" DockPanel.Dock="Top" Background="{StaticResource AmbarFundo}" BorderBrush="#40F59E0B"
                    BorderThickness="0,0,0,1" Padding="28,10" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Abrir como administrador" Click="AbrirComoAdmin_Click" Margin="0"/>
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE7BA;" Foreground="{StaticResource Ambar}" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Ambar}"
                               Text="Aberto sem administrador: ameaças, quarentena e a limpeza das pastas do Windows ficam limitadas."/>
                </DockPanel>
            </Border>

            <Grid Margin="28,24,16,16">
                <!-- ========== INÍCIO ========== -->
                <ScrollViewer x:Name="PaginaInicio" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="CartaoStatus" Style="{StaticResource CartaoBorda}" Padding="22" Background="{StaticResource VerdeFundo}" BorderBrush="#3322C55E">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BotaoPrincipal}" Click="VarreduraRapida_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icone}" Text="&#xE721;" Foreground="White" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="Varredura rápida" Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnAtualizar" Click="AtualizarAssinaturas_Click" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icone}" Text="&#xE895;" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="Atualizar assinaturas"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Border x:Name="CirculoStatus" Width="52" Height="52" CornerRadius="26" Background="{StaticResource Verde}" VerticalAlignment="Center">
                                    <TextBlock x:Name="IconeStatus" Style="{StaticResource Icone}" Text="&#xEA18;" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="18,0,16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtStatus" Text="Verificando..." Style="{StaticResource Titulo}"/>
                                    <TextBlock x:Name="TxtStatusDetalhe" Style="{StaticResource Fraco}" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Proteção" Style="{StaticResource Subtitulo}" Margin="2,8,0,10"/>
                        <UniformGrid x:Name="GradeProtecao" Columns="3"/>

                        <TextBlock Text="Computador" Style="{StaticResource Subtitulo}" Margin="2,8,0,10"/>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource CartaoBorda}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="TxtCpu" DockPanel.Dock="Right" FontWeight="SemiBold" Text="0%"/>
                                        <TextBlock Text="Processador" Style="{StaticResource Fraco}"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarraCpu" Margin="0,12,0,0" Maximum="100"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CartaoBorda}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="TxtRam" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                                        <TextBlock Text="Memória" Style="{StaticResource Fraco}"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="BarraRam" Margin="0,12,0,0" Maximum="100"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CartaoBorda}">
                                <StackPanel>
                                    <TextBlock Text="Ligado há" Style="{StaticResource Fraco}"/>
                                    <TextBlock x:Name="TxtUptime" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <ItemsControl x:Name="ListaDiscos">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CartaoBorda}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding UsoPercent, StringFormat={}{0:0}%}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource Fraco}">
                                                    <Run Text="{Binding Letra, Mode=OneWay}"/> <Run Text="{Binding Nome, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding UsoPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,8"/>
                                            <TextBlock Text="{Binding Texto}" Style="{StaticResource Fraco}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== VARREDURA ========== -->
                <DockPanel x:Name="PaginaVarredura" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Varredura" Style="{StaticResource Titulo}" Margin="0,0,0,4"/>
                        <TextBlock Text="O Windows Defender faz a varredura. Você pode continuar usando o PC enquanto isso." Style="{StaticResource Fraco}" Margin="0,0,0,18"/>
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource CartaoBorda}">
                                <DockPanel>
                                    <Button x:Name="BtnRapida" DockPanel.Dock="Right" Style="{StaticResource BotaoPrincipal}" Content="Iniciar" Click="VarreduraRapida_Click" VerticalAlignment="Center" Margin="0"/>
                                    <StackPanel>
                                        <TextBlock Text="Varredura rápida" Style="{StaticResource Subtitulo}"/>
                                        <TextBlock Text="Olha os lugares onde vírus costumam ficar. Leva poucos minutos." Style="{StaticResource Fraco}" Margin="0,4,12,0"/>
                                        <TextBlock x:Name="TxtUltimaRapida" Style="{StaticResource Fraco}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource CartaoBorda}">
                                <DockPanel>
                                    <Button x:Name="BtnCompleta" DockPanel.Dock="Right" Content="Iniciar" Click="VarreduraCompleta_Click" VerticalAlignment="Center" Margin="0"/>
                                    <StackPanel>
                                        <TextBlock Text="Varredura completa" Style="{StaticResource Subtitulo}"/>
                                        <TextBlock Text="Olha todos os arquivos do PC. Pode levar mais de uma hora." Style="{StaticResource Fraco}" Margin="0,4,12,0"/>
                                        <TextBlock x:Name="TxtUltimaCompleta" Style="{StaticResource Fraco}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </UniformGrid>

                        <Border x:Name="CartaoAndamento" Style="{StaticResource CartaoBorda}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="BtnCancelar" DockPanel.Dock="Right" Content="Cancelar" Click="CancelarVarredura_Click" Margin="0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="TxtAndamento" Style="{StaticResource Subtitulo}"/>
                                        <TextBlock x:Name="TxtTempo" Style="{StaticResource Fraco}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <ProgressBar x:Name="BarraVarredura" IsIndeterminate="True" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Resultado" Style="{StaticResource Subtitulo}" Margin="2,6,0,10"/>
                    </StackPanel>
                    <TextBox x:Name="LogVarredura" Style="{StaticResource Log}" Margin="0,0,12,0" Text="Nenhuma varredura feita por este painel ainda."/>
                </DockPanel>

                <!-- ========== AMEAÇAS ========== -->
                <DockPanel x:Name="PaginaAmeacas" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,12,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Atualizar" Click="AtualizarAmeacas_Click"/>
                                <Button x:Name="BtnTratar" Content="Tratar ameaças ativas" Click="TratarAmeacas_Click"/>
                                <Button Content="Segurança do Windows" Click="AbrirSeguranca_Click" Margin="0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Ameaças e quarentena" Style="{StaticResource Titulo}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtResumoAmeacas" Style="{StaticResource Fraco}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Histórico de ameaças" Style="{StaticResource Subtitulo}" Margin="2,0,0,10"/>
                    </StackPanel>
                    <Grid Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="GradeAmeacas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ameaça" Binding="{Binding Nome}" Width="2*"/>
                                <DataGridTextColumn Header="Gravidade" Binding="{Binding Gravidade}" Width="90"/>
                                <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="130"/>
                                <DataGridTextColumn Header="Detectada" Binding="{Binding Detectada, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                                <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="Quarentena" Style="{StaticResource Subtitulo}" Margin="2,16,0,10"/>
                        <TextBox Grid.Row="2" x:Name="TxtQuarentena" Style="{StaticResource Log}"/>
                    </Grid>
                </DockPanel>

                <!-- ========== OTIMIZAÇÃO ========== -->
                <DockPanel x:Name="PaginaLimpeza" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,12,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnAnalisar" Content="Analisar" Click="Analisar_Click"/>
                                <Button x:Name="BtnLimpar" Style="{StaticResource BotaoPrincipal}" Content="Limpar selecionados" Click="Limpar_Click" Margin="0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Otimização" Style="{StaticResource Titulo}" Margin="0,0,0,4"/>
                                <TextBlock Text="Apaga só arquivos que o Windows e os programas recriam sozinhos. Arquivos em uso são pulados." Style="{StaticResource Fraco}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock x:Name="TxtResultadoLimpeza" DockPanel.Dock="Bottom" Style="{StaticResource Fraco}" FontSize="13" Margin="2,6,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListaLimpeza">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CartaoBorda}" Padding="16,14">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tamanho}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                            <CheckBox IsChecked="{Binding Marcado}" Margin="0,0,14,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Descricao}" Style="{StaticResource Fraco}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ========== INICIALIZAÇÃO ========== -->
                <DockPanel x:Name="PaginaInicializacao" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,12,18">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Atualizar" Click="AtualizarInicializacao_Click"/>
                            <Button Style="{StaticResource BotaoPrincipal}" Content="Ligar ou desligar no Gerenciador" Click="AbrirGerenciador_Click" Margin="0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Inicialização" Style="{StaticResource Titulo}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtResumoInicializacao" Style="{StaticResource Fraco}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="GradeInicializacao" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Programa" Binding="{Binding Nome}" Width="200"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                            <DataGridTextColumn Header="Origem" Binding="{Binding Origem}" Width="160"/>
                            <DataGridTextColumn Header="Comando" Binding="{Binding Comando}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
