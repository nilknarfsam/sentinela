<Window x:Class="Sentinela.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:p="clr-namespace:Sentinela.Paginas"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentinela" Width="1100" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource Fundo}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="205"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== MENU LATERAL ===================== -->
        <Border Background="{StaticResource Lateral}" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,14,20">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Destaque}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xEA18;" Foreground="White" FontSize="17" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Sentinela" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="Windows Defender" Style="{StaticResource Fraco}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,14,16">
                    <Border Height="1" Background="{StaticResource Borda}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtAdminMenu" Style="{StaticResource Fraco}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtVersaoMenu" Style="{StaticResource Fraco}" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                  <StackPanel>
                    <RadioButton x:Name="MenuInicio" Style="{StaticResource ItemMenu}" Tag="&#xE80F;" Content="Início" IsChecked="True" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuSeguranca" Style="{StaticResource ItemMenu}" Tag="&#xEA18;" Content="Segurança" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuDesempenho" Style="{StaticResource ItemMenu}" Tag="&#xEC4A;" Content="Desempenho" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuVarredura" Style="{StaticResource ItemMenu}" Tag="&#xE721;" Content="Varredura" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuAmeacas" Style="{StaticResource ItemMenu}" Tag="&#xE7BA;" Content="Ameaças e quarentena" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuHistorico" Style="{StaticResource ItemMenu}" Tag="&#xE81C;" Content="Histórico" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuLimpeza" Style="{StaticResource ItemMenu}" Tag="&#xE74D;" Content="Otimização" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuInicializacao" Style="{StaticResource ItemMenu}" Tag="&#xE7E8;" Content="Inicialização" Checked="Menu_Checked"/>
                    <RadioButton x:Name="MenuAjustes" Style="{StaticResource ItemMenu}" Tag="&#xE713;" Content="Ajustes" Checked="Menu_Checked"/>
                  </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== CONTEÚDO ===================== -->
        <DockPanel Grid.Column="1">
            <!-- Aviso de administrador -->
            <Border x:Name="FaixaAdmin" DockPanel.Dock="Top" Background="{StaticResource AmbarFundo}" BorderBrush="{StaticResource Ambar}"
                    BorderThickness="0,0,0,1" Padding="18,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE7BA;" Foreground="{StaticResource Ambar}" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Texto}"
                               TextWrapping="Wrap" Text="Modo limitado · Sem administrador. Ameaças, quarentena e a limpeza das pastas do Windows ficam limitadas."/>
                    <Button Grid.Column="2" Content="Abrir como administrador" Click="AbrirComoAdmin_Click" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <Grid Margin="28,24,16,16">
                <p:PaginaInicio x:Name="PaginaInicio"/>
                <ContentControl x:Name="ConteudoSeguranca" Visibility="Collapsed"/>
                <ContentControl x:Name="ConteudoDesempenho" Visibility="Collapsed"/>
                <p:PaginaVarredura x:Name="PaginaVarredura" Visibility="Collapsed"/>
                <p:PaginaAmeacas x:Name="PaginaAmeacas" Visibility="Collapsed"/>
                <p:PaginaHistorico x:Name="PaginaHistorico" Visibility="Collapsed"/>
                <p:PaginaLimpeza x:Name="PaginaLimpeza" Visibility="Collapsed"/>
                <p:PaginaInicializacao x:Name="PaginaInicializacao" Visibility="Collapsed"/>
                <p:PaginaAjustes x:Name="PaginaAjustes" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
