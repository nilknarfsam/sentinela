<UserControl x:Class="Sentinela.Paginas.PaginaVarredura"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" PreviewDragOver="Pagina_DragOver" PreviewDrop="Pagina_Drop">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
            <TextBlock Text="Varredura" Style="{StaticResource Titulo}" Margin="0,0,0,4"/>
            <TextBlock Text="O Windows Defender faz a varredura. Você pode continuar usando o PC enquanto isso." Style="{StaticResource Fraco}" Margin="0,0,0,18"/>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource CartaoBorda}">
                    <DockPanel>
                        <Button x:Name="BtnRapida" DockPanel.Dock="Right" Style="{StaticResource BotaoPrincipal}" Content="Iniciar" Click="VarreduraRapida_Click" VerticalAlignment="Center" Margin="0"/>
                        <StackPanel>
                            <TextBlock Text="Varredura rápida" Style="{StaticResource Subtitulo}"/>
                            <TextBlock Text="Olha os lugares onde vírus costumam ficar. Leva poucos minutos." Style="{StaticResource Fraco}" Margin="0,4,12,0"/>
                            <TextBlock x:Name="TxtUltimaRapida" Style="{StaticResource Fraco}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CartaoBorda}">
                    <DockPanel>
                        <Button x:Name="BtnCompleta" DockPanel.Dock="Right" Content="Iniciar" Click="VarreduraCompleta_Click" VerticalAlignment="Center" Margin="0"/>
                        <StackPanel>
                            <TextBlock Text="Varredura completa" Style="{StaticResource Subtitulo}"/>
                            <TextBlock Text="Olha todos os arquivos do PC. Pode levar mais de uma hora." Style="{StaticResource Fraco}" Margin="0,4,12,0"/>
                            <TextBlock x:Name="TxtUltimaCompleta" Style="{StaticResource Fraco}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource CartaoBorda}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="BtnPasta" Content="Escolher pasta" Click="EscolherPasta_Click"/>
                        <Button x:Name="BtnArquivo" Content="Escolher arquivo" Click="EscolherArquivo_Click" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock Text="Verificar pasta ou arquivo" Style="{StaticResource Subtitulo}"/>
                        <TextBlock x:Name="TxtPersonalizada" TextWrapping="Wrap" Text="Escolha ou arraste uma pasta ou arquivo para cá." Style="{StaticResource Fraco}" Margin="0,4,12,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CartaoBorda}">
                <DockPanel>
                    <Button x:Name="BtnOffline" DockPanel.Dock="Right" Content="Reiniciar e verificar" Click="VarreduraOffline_Click" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel>
                        <TextBlock Text="Varredura offline (avançado)" Style="{StaticResource Subtitulo}"/>
                        <TextBlock Text="Reinicia o PC e verifica antes do Windows carregar, para achar vírus que se escondem. Leva uns 15 minutos. Salve seus trabalhos antes." Style="{StaticResource Fraco}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                        <TextBlock x:Name="TxtOfflineAdmin" Text="Abra como administrador para usar." Style="{StaticResource Fraco}" Visibility="Collapsed" Margin="0,8,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="CartaoAndamento" Style="{StaticResource CartaoBorda}" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="BtnCancelar" DockPanel.Dock="Right" Content="Cancelar" Click="CancelarVarredura_Click" Margin="0"/>
                        <StackPanel>
                            <TextBlock x:Name="TxtAndamento" Style="{StaticResource Subtitulo}"/>
                            <TextBlock x:Name="TxtCaminho" Style="{StaticResource Fraco}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TxtTempo" Style="{StaticResource Fraco}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="BarraVarredura" IsIndeterminate="True" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Resultado" Style="{StaticResource Subtitulo}" Margin="2,6,0,10"/>
        <Border Style="{StaticResource CartaoBorda}" Padding="8" Margin="0,0,12,12">
            <TextBox x:Name="LogVarredura" Style="{StaticResource Log}" MaxHeight="300" MinHeight="100" Text="Nenhuma varredura feita pelo Sentinela ainda."/>
        </Border>
      </StackPanel>
    </ScrollViewer>
</UserControl>
