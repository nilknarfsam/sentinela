<UserControl x:Class="Sentinela.Paginas.PaginaHistorico"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TextoEvento" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Alerta}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Vermelho}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="0,0,12,0">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Histórico" Style="{StaticResource Titulo}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtResumo" Text="Carregando eventos..." Style="{StaticResource Fraco}" Margin="0,0,0,16"/>
            <WrapPanel x:Name="Filtros">
                <Button Content="Tudo" Tag="tudo" Click="Filtrar_Click" Style="{StaticResource BotaoPrincipal}"/>
                <Button Content="Ameaças" Tag="ameacas" Click="Filtrar_Click"/>
                <Button Content="Varreduras" Tag="varreduras" Click="Filtrar_Click"/>
                <Button Content="Proteção e ajustes" Tag="protecao" Click="Filtrar_Click"/>
                <Button Content="Desempenho" Tag="desempenho" Click="Filtrar_Click"/>
                <Button Content="Limpeza" Tag="limpeza" Click="Filtrar_Click"/>
            </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="GradeHistorico">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Quando" Binding="{Binding Data, StringFormat=dd/MM HH:mm}" Width="100" ElementStyle="{StaticResource TextoEvento}"/>
                <DataGridTextColumn Header="Origem" Binding="{Binding Origem}" Width="85" ElementStyle="{StaticResource TextoEvento}"/>
                <DataGridTextColumn Header="O que aconteceu" Binding="{Binding Titulo}" Width="230" ElementStyle="{StaticResource TextoEvento}"/>
                <DataGridTextColumn Header="Detalhe" Binding="{Binding Detalhe}" Width="*" ElementStyle="{StaticResource TextoEvento}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
