<UserControl x:Class="Sentinela.Paginas.PaginaDesempenho"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,12,16">
            <DockPanel>
                <Button x:Name="BtnVerificar" DockPanel.Dock="Right" Style="{StaticResource BotaoPrincipal}"
                        Content="Verificar o PC" Click="Verificar_Click" Margin="12,0,0,0"/>
                <TextBlock Text="Desempenho" Style="{StaticResource Titulo}"/>
            </DockPanel>
            <TextBlock x:Name="TxtErro" Style="{StaticResource Fraco}" Margin="0,8,0,0"/>
            <TextBlock Text="Verifica o que deixa o PC lento. Nada muda sem você confirmar." Style="{StaticResource Fraco}" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="Convite" Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <TextBlock Text="Como está o desempenho do seu PC?" Style="{StaticResource Subtitulo}"/>
                        <TextBlock Text="Clique em Verificar o PC para conferir o que pode deixar o Windows lento." Style="{StaticResource Fraco}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CartaoNota" Style="{StaticResource CartaoBorda}" Padding="12" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNota" FontSize="40" FontWeight="SemiBold"/>
                            <TextBlock Text="de 100" Style="{StaticResource Fraco}" VerticalAlignment="Bottom" Margin="8,0,0,12"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFaixa" Style="{StaticResource Subtitulo}"/>
                            <TextBlock x:Name="TxtConfianca" Style="{StaticResource Fraco}" Foreground="{StaticResource Ambar}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtQuando" Style="{StaticResource Fraco}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CartaoBorda}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <DockPanel><TextBlock x:Name="TxtCpuAtual" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="CPU total" Style="{StaticResource Fraco}"/></DockPanel>
                            <ProgressBar x:Name="BarraCpuAtual" Maximum="100" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <DockPanel><TextBlock x:Name="TxtMemoriaAtual" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="Memória total" Style="{StaticResource Fraco}"/></DockPanel>
                            <ProgressBar x:Name="BarraMemoriaAtual" Maximum="100" Foreground="{StaticResource Ambar}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ItemsControl x:Name="ListaVerificacoes">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CartaoBorda}" Padding="8">
                                <StackPanel>
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{Binding CorNivel}" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Item.Icone}" Style="{StaticResource Icone}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Item.Nome}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Item.Resumo}" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Item.Detalhe}" Style="{StaticResource Fraco}" Margin="0,3,0,0"/>
                                    <Button Content="{Binding Item.Acao.Texto}" Tag="{Binding Item.Acao}" Click="Resolver_Click"
                                            Visibility="{Binding VisibilidadeAcao}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,4" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="SecaoAgora" Style="{StaticResource CartaoBorda}" Padding="12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Agora" Style="{StaticResource Subtitulo}"/>
                            <TextBlock Text="Última hora · janela aberta" Style="{StaticResource Fraco}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Grid Margin="0,6,0,6" Height="90">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="100%" Style="{StaticResource Fraco}"/>
                            <TextBlock Text="0%" Style="{StaticResource Fraco}" VerticalAlignment="Bottom"/>
                            <Canvas x:Name="Grafico" Grid.Column="1" ClipToBounds="True" Background="{StaticResource Fundo}" SizeChanged="Grafico_SizeChanged">
                                <Path x:Name="LinhaCpu" Stroke="{StaticResource Destaque}" StrokeThickness="2"/>
                                <Path x:Name="LinhaMemoria" Stroke="{StaticResource Ambar}" StrokeThickness="2"/>
                            </Canvas>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="━ CPU" Foreground="{StaticResource Destaque}" Margin="0,0,16,0"/>
                            <TextBlock Text="━ Memória" Foreground="{StaticResource Ambar}"/>
                            <TextBlock x:Name="TxtHistorico" Style="{StaticResource Fraco}" Margin="16,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnAmostrar" Content="Ver o que está pesando" Click="Amostrar_Click" Padding="10,5"/>
                            <Button x:Name="BtnCpu" Content="CPU ↓" Click="OrdenarCpu_Click" Padding="10,5"/>
                            <Button x:Name="BtnMemoria" Content="Memória" Click="OrdenarMemoria_Click" Padding="10,5"/>
                        </StackPanel>
                        <ProgressBar x:Name="ProgressoAmostra" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6,0,0"/>
                        <TextBlock x:Name="TxtProcessos" Style="{StaticResource Fraco}" Margin="0,6,0,6" Text="Amostra de 2 segundos. CPU considera todos os núcleos; memória privada quando disponível."/>
                        <DataGrid x:Name="ListaProcessos" CanUserSortColumns="False" MaxHeight="340" RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Programa" Binding="{Binding Nome}" Width="2*"/>
                                <DataGridTextColumn Header="Editora" Binding="{Binding Editora, TargetNullValue=—}" Width="*"/>
                                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuTexto}" Width="65"/>
                                <DataGridTextColumn Header="Memória" Binding="{Binding MemoriaTexto}" Width="85"/>
                                <DataGridTemplateColumn Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Finalizar" Tag="{Binding}" IsEnabled="{Binding PodeFinalizar}" ToolTip="{Binding Dica}" ToolTipService.ShowOnDisabled="True" Click="Finalizar_Click" Padding="6,3" FontSize="13" Margin="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="SecaoDiscos" Margin="0,4,12,0">
                    <TextBlock Text="Discos" Style="{StaticResource Subtitulo}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="AvisoAdminDiscos" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock Text="Abra como administrador para ver desgaste e temperatura." Style="{StaticResource Fraco}"/>
                        <Button Content="Abrir como administrador" Click="AdminDiscos_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtDiscos" Style="{StaticResource Fraco}"/>
                    <ItemsControl x:Name="ListaDiscos">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource CartaoBorda}" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Right" Width="9" Height="9" Fill="{Binding CorNivel}" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Disco.Nome}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource Fraco}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding DetalheOperacional}" Style="{StaticResource Fraco}"/>
                                    <StackPanel Visibility="{Binding Avancados}" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding DesgasteTexto}"/>
                                        <ProgressBar Maximum="100" Value="{Binding Disco.DesgastePercent, TargetNullValue=0}" Foreground="{Binding CorNivel}" Margin="0,4,0,6"/>
                                        <TextBlock Text="{Binding TemperaturaTexto}"/>
                                        <ProgressBar Maximum="100" Value="{Binding Disco.Temperatura, TargetNullValue=0}" Foreground="{Binding CorNivel}" Margin="0,4,0,6"/>
                                        <TextBlock Text="{Binding ContadoresTexto}" Style="{StaticResource Fraco}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
