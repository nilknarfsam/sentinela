<UserControl x:Class="Sentinela.Paginas.PaginaInicio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Visão geral" Style="{StaticResource Titulo}" Margin="2,0,0,14"/>
            <Border x:Name="CartaoStatus" Style="{StaticResource CartaoBorda}" Padding="22" Background="{StaticResource VerdeFundo}" BorderBrush="{StaticResource Verde}">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <DockPanel>
                    <Border x:Name="CirculoStatus" DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="26" Background="{StaticResource Verde}" VerticalAlignment="Center">
                        <TextBlock x:Name="IconeStatus" Style="{StaticResource Icone}" Text="&#xEA18;" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatus" Text="Verificando..." Style="{StaticResource Titulo}"/>
                        <TextBlock x:Name="TxtStatusDetalhe" Style="{StaticResource Fraco}" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DockPanel>
                  <WrapPanel Grid.Row="1" Margin="70,10,0,0">
                        <Button Style="{StaticResource BotaoPrincipal}" Click="VarreduraRapida_Click" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE721;" Foreground="White" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Varredura rápida" Foreground="White" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAtualizar" Click="AtualizarAssinaturas_Click" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE895;" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Atualizar assinaturas"/>
                            </StackPanel>
                        </Button>
                  </WrapPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="TxtTituloProtecao" Text="Proteção do Defender" Style="{StaticResource Subtitulo}" Margin="2,8,0,10"/>
            <UniformGrid x:Name="GradeProtecao" Columns="3"/>

            <UniformGrid Columns="2">
            <Border Style="{StaticResource CartaoBorda}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Ver" Click="Seguranca_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="Saúde da segurança" Style="{StaticResource Subtitulo}"/>
                        <TextBlock x:Name="TxtSeguranca" Text="Ainda não verificado" Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtNovaSeguranca" Text="Faça uma verificação nova" Foreground="{StaticResource Ambar}" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource CartaoBorda}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Ver" Click="Desempenho_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="Desempenho" Style="{StaticResource Subtitulo}"/>
                        <TextBlock x:Name="TxtDesempenho" Text="Ainda não verificado" Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtNovoCheckup" Text="Faça uma verificação nova" Foreground="{StaticResource Ambar}" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            </UniformGrid>

            <TextBlock Text="Computador" Style="{StaticResource Subtitulo}" Margin="2,8,0,10"/>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="TxtCpu" DockPanel.Dock="Right" FontWeight="SemiBold" Text="0%"/>
                            <TextBlock Text="Processador" Style="{StaticResource Fraco}"/>
                        </DockPanel>
                        <ProgressBar x:Name="BarraCpu" Margin="0,12,0,0" Maximum="100"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="TxtRam" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                            <TextBlock Text="Memória" Style="{StaticResource Fraco}"/>
                        </DockPanel>
                        <ProgressBar x:Name="BarraRam" Margin="0,12,0,0" Maximum="100"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <TextBlock Text="Ligado há" Style="{StaticResource Fraco}"/>
                        <TextBlock x:Name="TxtUptime" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <ItemsControl x:Name="ListaDiscos">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CartaoBorda}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsoPercent, StringFormat={}{0:0}%}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Fraco}">
                                        <Run Text="{Binding Letra, Mode=OneWay}"/> <Run Text="{Binding Nome, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                                <ProgressBar Value="{Binding UsoPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,8"/>
                                <TextBlock Text="{Binding Texto}" Style="{StaticResource Fraco}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
