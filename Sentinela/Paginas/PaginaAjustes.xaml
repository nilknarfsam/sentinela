<UserControl x:Class="Sentinela.Paginas.PaginaAjustes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,12,18">
            <TextBlock Text="Ajustes" Style="{StaticResource Titulo}" Margin="0,0,0,4"/>
            <TextBlock Text="Escolha como o Sentinela se comporta no dia a dia." Style="{StaticResource Fraco}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TabControl x:Name="AbasAjustes" SelectedIndex="0">
              <TabItem Header="Geral">
               <Grid Margin="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource CartaoBorda}" Grid.ColumnSpan="2">
                    <StackPanel>
                        <TextBlock Text="Iniciar com o Windows" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkInicializacao" Content="Abrir o Sentinela na bandeja ao entrar no Windows" Click="Inicializacao_Click"/>
                        <TextBlock x:Name="TxtInicializacao" Style="{StaticResource Fraco}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <TextBlock Text="Ao fechar a janela" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkBandeja" Click="Bandeja_Click">
                            <TextBlock Text="Manter o Sentinela na bandeja (perto do relógio)"/>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <TextBlock Text="Avisos" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkAvisos" Click="Avisos_Click">
                            <TextBlock Text="Avisar também quando tudo der certo (varredura limpa, assinaturas atualizadas)"/>
                        </CheckBox>
                        <TextBlock Text="Avisos de ameaça e de proteção desligada sempre aparecem." Style="{StaticResource Fraco}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
               </Grid>
              </TabItem>
              <TabItem Header="Rotina semanal">
               <StackPanel Margin="4">
                <Border Style="{StaticResource CartaoBorda}">
                 <StackPanel>
                        <TextBlock Text="Varredura completa semanal" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkSemanal" Content="Fazer uma varredura completa toda semana" Click="Semanal_Changed"/>
                        <WrapPanel Margin="0,10,0,10">
                            <TextBlock Text="Dia: " VerticalAlignment="Center"/>
                            <ComboBox x:Name="DiaSemanal" Width="170" SelectionChanged="Semanal_Changed"/>
                            <TextBlock Text="Hora: " Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="HoraSemanal" Width="85" SelectionChanged="Semanal_Changed"/>
                        </WrapPanel>
                        <TextBlock Text="Se o PC estiver desligado na hora marcada, o Sentinela faz a varredura quando você voltar e o PC ficar parado por 10 minutos." Style="{StaticResource Fraco}"/>
                        <TextBlock x:Name="TxtUltimaCompleta" Text="Última varredura completa: consultando..." Margin="0,8,0,0"/>
                 </StackPanel>
                </Border>
               </StackPanel>
              </TabItem>
              <TabItem Header="Pastas de projetos">
               <StackPanel Margin="4">
                <Border Style="{StaticResource CartaoBorda}">
                 <StackPanel>
                        <TextBlock Text="Pastas dos seus projetos" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                        <TextBlock Text="Analisa até 3 níveis. SDKs do Flutter e links são ignorados." Style="{StaticResource Fraco}"/>
                        <ListBox x:Name="ListaProjetos" Margin="0,10,0,10" MaxHeight="180"
                                 Background="{StaticResource Fundo}" Foreground="{StaticResource Texto}"
                                 BorderBrush="{StaticResource Borda}"/>
                        <WrapPanel>
                            <Button Content="Adicionar pasta" Click="AdicionarPasta_Click"/>
                            <Button Content="Remover" Click="RemoverPasta_Click"/>
                        </WrapPanel>
                 </StackPanel>
                </Border>
               </StackPanel>
              </TabItem>
              <TabItem x:Name="AbaSobreAjuda" Header="Sobre e ajuda">
               <Grid Margin="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <TextBlock Text="Sentinela" Style="{StaticResource Titulo}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtVersao" Style="{StaticResource Fraco}"/>
                        <TextBlock Text="Grátis. Usa o Windows Defender como motor." Style="{StaticResource Subtitulo}" Margin="0,10,0,4"/>
                        <TextBlock Text="Criado por Franklin Carvalho." Style="{StaticResource Fraco}" Margin="0,0,0,2"/>
                        <TextBlock Text="Software livre sob a licença GPL-3.0 ou posterior. Sem garantia." Style="{StaticResource Fraco}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="Links do criador" Style="{StaticResource Subtitulo}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="GitHub" Tag="https://github.com/nilknarfsam" Click="AbrirLinkAjuda_Click" AutomationProperties.Name="Abrir GitHub do criador"/>
                            <Button Content="Site" Tag="https://samfieldsoak.com.br" Click="AbrirLinkAjuda_Click" AutomationProperties.Name="Abrir site do criador"/>
                            <Button Content="Instagram" Tag="https://www.instagram.com/samfieldsoak" Click="AbrirLinkAjuda_Click" AutomationProperties.Name="Abrir Instagram do criador"/>
                            <Button Content="LinkedIn" Tag="https://www.linkedin.com/in/franklin-carvalho-45032a164/" Click="AbrirLinkAjuda_Click" AutomationProperties.Name="Abrir LinkedIn do criador"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtResultadoLinkAjuda" Style="{StaticResource Fraco}" Margin="0,4,0,0"/>
                        <Border Height="1" Background="{StaticResource Borda}" Margin="0,14,0,12"/>
                        <TextBlock Text="Outros recursos" Style="{StaticResource Subtitulo}" Margin="0,0,0,8"/>
                        <TextBlock Text="Página do Sentinela — em breve." Style="{StaticResource Fraco}" Margin="0,0,0,6"/>
                        <TextBlock Text="Relatar um problema — em breve." Style="{StaticResource Fraco}" Margin="0,0,0,6"/>
                        <TextBlock Text="Privacidade — informações detalhadas em breve." Style="{StaticResource Fraco}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <TextBlock Text="O que você encontra no Sentinela" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>
                        <TextBlock Text="Início — resumo da proteção e do estado do PC." Margin="0,0,0,8"/>
                        <TextBlock Text="Segurança — verificações das proteções do Windows." Margin="0,0,0,8"/>
                        <TextBlock Text="Desempenho — o que pode estar deixando o PC lento." Margin="0,0,0,8"/>
                        <TextBlock Text="Varredura — peça ao Defender para verificar o PC, uma pasta ou um arquivo." Margin="0,0,0,8"/>
                        <TextBlock Text="Ameaças e quarentena — veja detecções e opções de tratamento." Margin="0,0,0,8"/>
                        <TextBlock Text="Histórico — consulte varreduras, avisos e atividades recentes." Margin="0,0,0,8"/>
                        <TextBlock Text="Otimização — analise temporários, caches e sobras de projetos antes de limpar." Margin="0,0,0,8"/>
                        <TextBlock Text="Inicialização — veja o que abre com o Windows e ajuste itens compatíveis." Margin="0,0,0,8"/>
                        <TextBlock Text="Ajustes — escolha preferências, rotina semanal e pastas de projetos."/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CartaoBorda}">
                    <StackPanel>
                        <TextBlock Text="Versão e diário" Style="{StaticResource Subtitulo}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtDiario" Style="{StaticResource Fraco}" Margin="0,0,0,10"/>
                        <Button Content="Abrir a pasta do diário" HorizontalAlignment="Left" Click="AbrirDiario_Click"/>
                        <TextBlock Text="Arquivo do programa" Style="{StaticResource Subtitulo}" Margin="0,14,0,4"/>
                        <TextBlock x:Name="TxtExecutavel" Style="{StaticResource Fraco}"/>
                    </StackPanel>
                </Border>
               </Grid>
              </TabItem>
            </TabControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
